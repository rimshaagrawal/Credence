# =============================================================================
# Credence — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real secrets. This file is safe to commit (example values only).
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Get from: Supabase dashboard → Project Settings → Database → Connection string
# Use the "Transaction" pooler URL for the API server (port 6543)
# Use the "Session" pooler URL for Drizzle migrations (port 5432)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct connection for migrations (Drizzle push) — Session mode
DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# SUPABASE (client-side, safe to expose)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# API SERVER
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# CORS: Comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# FRONTEND (Vite — prefix with VITE_ to expose to browser)
# -----------------------------------------------------------------------------
# URL of the backend API (Render URL in production, localhost in dev)
VITE_API_BASE_URL=http://localhost:8080

# Your Vercel frontend URL (used for QR code generation and public profile links)
VITE_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# AUTHENTICATION (Clerk — when configured)
# -----------------------------------------------------------------------------
# CLERK_SECRET_KEY=sk_test_...              # Server-side only — never expose
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...    # Safe for frontend

# -----------------------------------------------------------------------------
# EVIDENCE DISCOVERY (TinyFish — when configured)
# -----------------------------------------------------------------------------
# TINYFISH_API_KEY=...    # Server-side only — never expose to frontend

# -----------------------------------------------------------------------------
# AI REVIEW (when configured)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=...      # Server-side only — never expose to frontend
# AI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# BLOCKCHAIN / WEB3 (when configured)
# -----------------------------------------------------------------------------
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/...
# BLOCKCHAIN_SIGNING_KEY=0x...   # Server-side only — never expose to frontend
# CREDENTIAL_CONTRACT_ADDRESS=0x...

# -----------------------------------------------------------------------------
# FILE STORAGE (when configured)
# -----------------------------------------------------------------------------
# STORAGE_BUCKET=credence-documents
# STORAGE_ACCESS_KEY=...   # Server-side only
# STORAGE_SECRET_KEY=...   # Server-side only
